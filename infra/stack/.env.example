# Wird auf dem Server als .env angelegt (nicht im Repo).
POSTGRES_PASSWORD=
BASIS_URL=https://swarvex.example.org
BASIS_HOST=swarvex.example.org
# Labor: internal (eigene CA) · Live: E-Mail-Adresse für Let's Encrypt
TLS_MODUS=internal
# Konto-Anbieter für den Login (mindestens einer). Rücksprung jeweils <BASIS_URL>/interaction/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
GITEA_URL=https://git.example.org
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# Mindestalter des Kontos in Tagen (Labor 0, live 30)
KONTO_MINDESTALTER_TAGE=0
PRUEFSTRASSE_GEHEIMNIS=

# Suchmaschinen: im Labor ausgeschlossen. Live: INDEXIEREN=ja und X_ROBOTS_TAG=all
INDEXIEREN=nein
X_ROBOTS_TAG=noindex, nofollow
