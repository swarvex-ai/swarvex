# Created on the server as .env (not in the repository).
POSTGRES_PASSWORD=
BASE_URL=https://swarvex.example.org
BASE_HOST=swarvex.example.org
# Lab: internal (own CA) · production: email address for Let's Encrypt
TLS_MODE=internal
# Account providers for sign-in (at least one). Redirect each to <BASE_URL>/interaction/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
GITEA_URL=https://git.example.org
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# Minimum account age in days (lab 0, production 30)
ACCOUNT_MIN_AGE_DAYS=0
PIPELINE_SECRET=

# Search engines: excluded in the lab. Production: INDEXING=yes and X_ROBOTS_TAG=all
INDEXING=no
X_ROBOTS_TAG=noindex, nofollow
