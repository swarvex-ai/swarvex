# Wird auf dem Server als .env angelegt (nicht im Repo).
POSTGRES_PASSWORD=
BASE_URL=https://swarvex.example.org
BASE_HOST=swarvex.example.org
# Labor: internal (eigene CA) · Live: E-Mail-Adresse für Let's Encrypt
TLS_MODE=internal
# Konto-Anbieter für den Login (mindestens einer). Rücksprung jeweils <BASE_URL>/interaction/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
GITEA_URL=https://git.example.org
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# Mindestalter des Kontos in Tagen (Labor 0, live 30)
ACCOUNT_MIN_AGE_DAYS=0
PIPELINE_SECRET=

# Suchmaschinen: im Labor ausgeschlossen. Live: INDEXING=yes und X_ROBOTS_TAG=all
INDEXING=no
X_ROBOTS_TAG=noindex, nofollow
