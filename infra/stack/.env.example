# Created on the server as .env (not in the repository).
POSTGRES_PASSWORD=
# Memory for database pages (optional, default 128MB), e.g. 2GB on a large server
# PG_SHARED_BUFFERS=2GB
BASE_URL=https://swarvex.example.org
BASE_HOST=swarvex.example.org
# Lab: internal (own CA) · production: email address for Let's Encrypt
TLS_MODE=internal
# Account providers for sign-in (at least one). Redirect each to <BASE_URL>/interaction/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
GITEA_URL=https://git.example.org
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# Minimum account age in days (lab 0, production 30)
ACCOUNT_MIN_AGE_DAYS=0
# Exceptions by immutable account ID, e.g. test accounts: github:123,gitea:4
ACCOUNT_AGE_EXEMPT=
PIPELINE_SECRET=
# Key of a separate pipeline server (infra/setup-pipeline-host.sh): it may check and build previews, never merge.
# Leave empty when the pipeline runs on this server.
PIPELINE_SECRET_CHECK=
# Address of that pipeline server: the monitoring here then fetches its metrics through an SSH tunnel
# (infra/connect-pipeline-host.sh sets both).
PIPELINE_SERVER_ADDRESS=

# Search engines: excluded in the lab. Production: INDEXING=yes and X_ROBOTS_TAG=all
INDEXING=no
X_ROBOTS_TAG=noindex, nofollow
