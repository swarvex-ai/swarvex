# Spielbare Vorschauen auf eigener Domain, jedes Projekt auf eigener Subdomain (<slug>.<Domain>): Projekte teilen sich
# dann keinen Speicher (localStorage, IndexedDB) mehr. Zertifikate holt Caddy beim ersten Aufruf je Subdomain (On-Demand,
# freigegeben über /api/preview-allowed). infra/deploy.sh legt diese Datei an, wenn die .env VORSCHAU_DOMAIN nennt:
#   Live: VORSCHAU_DOMAIN=<eigene Domain>, im DNS ein A-Eintrag für die Domain selbst und für * auf den Server
*.{$VORSCHAU_DOMAIN} {
	tls {
		on_demand
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Godot-Web-Exporte mit Threads brauchen Cross-Origin-Isolation; alles muss von hier kommen (keine fremden Quellen)
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self' blob: data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
		-Server
	}
	encode zstd gzip
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	root * /vorschau/{labels.2}
	file_server
}

# Die Domain selbst zeigt nichts, sie führt zu swarvex.ai
{$VORSCHAU_DOMAIN} {
	redir https://swarvex.ai/ 302
}
