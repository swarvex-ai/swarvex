# Gleiche Datei für Labor und Live; der Unterschied steht in der .env:
#   Labor: BASE_HOST=<IP>     TLS_MODE=internal          (Caddys interne CA)
#   Live:  BASE_HOST=<Domain> TLS_MODE=<admin@domain>   (Let's Encrypt, E-Mail für Ablaufwarnungen)
{
	# Clients senden für IP-Adressen keinen Servernamen (SNI); bei Domains wirkungslos.
	default_sni {$BASE_HOST}
}
{$BASE_HOST} {
	tls {$TLS_MODE}
	# Labor: nicht indexieren (Standard). Live in .env: X_ROBOTS_TAG=all
	header X-Robots-Tag "{$X_ROBOTS_TAG:noindex, nofollow}"
	# Komprimieren (bereits komprimierte Antworten, z. B. vorgerenderte Doku, lässt Caddy unverändert)
	encode zstd gzip
	# Sicherheits-Header für alle Antworten
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# Einzeiler-Installer und signierte Runner-Releases (infra/release.sh)
	handle /install.sh {
		root * /srv
		file_server
	}
	# Windows (PowerShell): irm https://<host>/install.ps1 | iex
	handle /install.ps1 {
		root * /srv
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle /downloads/* {
		root * /srv
		uri strip_prefix /downloads
		file_server
	}
	# Erklärvideo und andere Medien (liegen neben den Downloads, siehe docs/self-hosting.md)
	handle /media/* {
		root * /srv
		file_server
	}
	# Website (apps/web): Startseite, Projekte, Doku, Assets
	@web path / /en /en/* /projekte /projekte/* /modelle /starten /lead/* /open-source /melden /report /konto /kontakt /contact /datenschutz /nutzungsbedingungen /privacy /terms /docs /docs/* /_app/* /favicon.svg /llms-full.txt /robots.txt /sitemap.xml /og.png /og-en.png /logo-512.png
	handle @web {
		reverse_proxy web:3000
	}
	handle {
		reverse_proxy api:3000
	}
}

# Spielbare Vorschauen der Projekte (Prüfstraße, pipeline/vorschau.go): Projektcode, deshalb auf eigener Adresse,
# nie unter der der Plattform. Ohne VORSCHAU_ADRESSE in der .env hört der Block nur innen auf 127.0.0.1 (aus).
#   Labor: VORSCHAU_ADRESSE=https://<IP>:8444      Live: VORSCHAU_ADRESSE=https://play.<Domain> (eigener DNS-Eintrag)
{$VORSCHAU_ADRESSE:http://127.0.0.1:8444} {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Godot-Web-Exporte mit Threads brauchen Cross-Origin-Isolation; alles muss von hier kommen (keine fremden Quellen)
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self' blob: data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
		-Server
	}
	encode zstd gzip
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	root * /srv/vorschau
	file_server
}

# Weitere Seiten auf demselben Server (z. B. andere Projekte): je eine Datei <name>.caddy in
# /opt/swarvex-data/sites. Deren Container hängen im gemeinsamen Netz "edge". Im Labor leer.
import /etc/caddy/sites/*.caddy
