# Gleiche Datei für Labor und Live; der Unterschied steht in der .env:
#   Labor: BASE_HOST=<IP>     TLS_MODE=internal          (Caddys interne CA)
#   Live:  BASE_HOST=<Domain> TLS_MODE=<admin@domain>   (Let's Encrypt, E-Mail für Ablaufwarnungen)
{
	# Clients senden für IP-Adressen keinen Servernamen (SNI); bei Domains wirkungslos.
	default_sni {$BASE_HOST}
	# Zertifikate für Vorschau-Subdomains (vorschau-domain.caddy) nur für Projekte, die eine Vorschau haben
	on_demand_tls {
		ask http://api:3000/api/preview-allowed
	}
}
{$BASE_HOST} {
	tls {$TLS_MODE}
	# Labor: nicht indexieren (Standard). Live in .env: X_ROBOTS_TAG=all
	header X-Robots-Tag "{$X_ROBOTS_TAG:noindex, nofollow}"
	# Komprimieren (bereits komprimierte Antworten, z. B. vorgerenderte Doku, lässt Caddy unverändert)
	encode zstd gzip
	# Sicherheits-Header für alle Antworten
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# Einzeiler-Installer und signierte Runner-Releases (infra/release.sh)
	handle /install.sh {
		root * /srv
		file_server
	}
	# Windows (PowerShell): irm https://<host>/install.ps1 | iex
	handle /install.ps1 {
		root * /srv
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle /downloads/* {
		root * /srv
		uri strip_prefix /downloads
		file_server
	}
	# Erklärvideo und andere Medien (liegen neben den Downloads, siehe docs/self-hosting.md)
	handle /media/* {
		root * /srv
		file_server
	}
	# Neue Besucher, deren Browser nicht Deutsch an erster Stelle nennt, landen auf der englischen Startseite.
	# Wer die Sprache selbst umschaltet, bekommt das Cookie swarvex_sprache und bleibt dort; ohne Accept-Language
	# (Suchmaschinen) bleibt / deutsch, beide Fassungen sind über hreflang verknüpft.
	@englisch {
		path /
		header Accept-Language *
		not header Accept-Language de*
		not header Cookie *swarvex_sprache=*
	}
	redir @englisch /en 302
	# Website (apps/web): Startseite, Projekte, Doku, Assets
	@web path / /en /en/* /projekte /projekte/* /modelle /mitstreiter /mitstreiter/* /starten /lead/* /open-source /melden /report /konto /kontakt /contact /datenschutz /nutzungsbedingungen /privacy /terms /docs /docs/* /_app/* /favicon.svg /llms-full.txt /robots.txt /sitemap.xml /og.png /og-en.png /logo-512.png
	handle @web {
		reverse_proxy web:3000
	}
	handle {
		reverse_proxy api:3000
	}
}

# Spielbare Vorschauen der Projekte: eigene Site in vorschau.caddy, nur eingebunden, wenn VORSCHAU_ADRESSE gesetzt ist (infra/deploy.sh).

# Weitere Seiten auf demselben Server (z. B. andere Projekte): je eine Datei <name>.caddy in
# /opt/swarvex-data/sites. Deren Container hängen im gemeinsamen Netz "edge". Im Labor leer.
import /etc/caddy/sites/*.caddy
