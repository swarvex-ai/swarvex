[Unit]
Description=swarvex test pipeline: check
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/opt/swarvex-data/pipeline.env
ExecStart=/usr/local/bin/swarvex-pipeline check
# Metrics of this run for Prometheus (infra/pipeline-metrics.sh)
ExecStopPost=-/bin/sh /opt/swarvex/infra/pipeline-metrics.sh check
