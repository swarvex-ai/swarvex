  {
   "id": 27,
   "type": "stat",
   "title": "Container sandbox",
   "gridPos": {
    "x": 20,
    "y": 40,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (runtime) (swarvex_pipeline_runtime_info{job=\"pruefserver\"})",
     "legendFormat": "{{runtime}}"
    }
   ],
   "description": "Runtime around every check container: runsc is gVisor (own kernel per container), runc would be plain Docker.",
   "options": {
    "textMode": "name",
    "colorMode": "none",
    "graphMode": "none"
   }
  },
  {
   "id": 28,
   "type": "stat",
   "title": "Last check run (ago)",
   "gridPos": {
    "x": 0,
    "y": 44,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(swarvex_pipeline_last_run_timestamp_seconds{job=\"pruefserver\",task=\"check\"})"
    }
   ],
   "description": "The check runs every minute; more than 5 minutes means its timer stopped."
  },
  {
   "id": 29,
   "type": "stat",
   "title": "Last run per task",
   "gridPos": {
    "x": 6,
    "y": 44,
    "w": 12,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "ok",
         "color": "green"
        },
        "0": {
         "text": "failed",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (task) (swarvex_pipeline_last_run_success)",
     "legendFormat": "{{task}}"
    }
   ],
   "description": "check and preview run on the pipeline server; merge and preview_fetch (fetching the built previews, read-only) on the platform. Details: journalctl -u swarvex-<task> on that server."
  },
  {
   "id": 30,
   "type": "stat",
   "title": "Previews fetched by the platform (ago)",
   "gridPos": {
    "x": 18,
    "y": 44,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 900
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(swarvex_pipeline_last_success_timestamp_seconds{job=\"integrations/unix\",task=\"preview_fetch\"})"
    }
   ],
   "description": "Every 5 minutes; more than 15 minutes means new previews do not reach the preview domain."
  },
