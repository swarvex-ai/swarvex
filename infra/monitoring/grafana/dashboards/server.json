{
 "uid": "swarvex-server",
 "title": "Server",
 "schemaVersion": 41,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "id": 20,
   "type": "row",
   "title": "Platform",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 1,
   "type": "stat",
   "title": "CPU in use",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"integrations/unix\",mode=\"idle\"}[5m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "CPU steal (other customers)",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg(rate(node_cpu_seconds_total{job=\"integrations/unix\",mode=\"steal\"}[5m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Memory in use",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes{job=\"integrations/unix\"} / node_memory_MemTotal_bytes{job=\"integrations/unix\"}"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Disk / in use",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_filesystem_avail_bytes{job=\"integrations/unix\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"integrations/unix\",mountpoint=\"/\"}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU by mode",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"integrations/unix\",mode!=\"idle\"}[5m])) / scalar(count(node_cpu_seconds_total{job=\"integrations/unix\",mode=\"idle\"}))",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memory",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes{job=\"integrations/unix\"} - node_memory_MemAvailable_bytes{job=\"integrations/unix\"}",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "expr": "node_memory_MemTotal_bytes{job=\"integrations/unix\"}",
     "legendFormat": "total"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Container memory",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (container_memory_working_set_bytes{job=\"integrations/cadvisor\",name!=\"\"})",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Container CPU",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"integrations/cadvisor\",name!=\"\"}[5m]))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Network",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(node_network_receive_bytes_total{job=\"integrations/unix\",device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))",
     "legendFormat": "in"
    },
    {
     "refId": "B",
     "expr": "sum(rate(node_network_transmit_bytes_total{job=\"integrations/unix\",device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))",
     "legendFormat": "out"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Disk I/O",
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(node_disk_read_bytes_total{job=\"integrations/unix\"}[5m]))",
     "legendFormat": "read"
    },
    {
     "refId": "B",
     "expr": "sum(rate(node_disk_written_bytes_total{job=\"integrations/unix\"}[5m]))",
     "legendFormat": "write"
    }
   ]
  },
  {
   "id": 11,
   "type": "logs",
   "title": "Errors in container logs",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{container=~\".+\"} |~ \"(?i)error|fatal|panic\""
    }
   ]
  },
  {
   "id": 21,
   "type": "row",
   "title": "Pipeline server (checks and previews of other people's code, gVisor)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 22,
   "type": "stat",
   "title": "Reachable",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "yes",
         "color": "green"
        },
        "0": {
         "text": "no",
         "color": "red"
        }
       }
      }
     ],
     "noValue": "not connected"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(up{job=\"pruefserver\"})"
    }
   ],
   "description": "The platform reads these metrics through an SSH tunnel it opens itself (infra/monitoring/compose.pipeline-server.yaml). no: pipeline server down or tunnel broken."
  },
  {
