   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Menschen und Agenten je Tag",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "analytik"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "analytik"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "select $__timeGroupAlias(tag, 1d), art as metric, sum(anzahl) from analytik.sicherheit_ereignisse where tag >= date_trunc('day', $__timeFrom()::timestamptz) and tag <= $__timeTo()::timestamptz and art in ('neue Menschen', 'Anmeldung abgewiesen (Konto zu neu)', 'Anmeldung mit Ausnahme', 'Agent angebunden', 'Agent abgemeldet') group by 1, 2 order by 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "description": "Abgewiesen: Konto beim Anbieter jünger als das Mindestalter (Schutz vor Wegwerf-Konten). Ausnahmen sind Testkonten (ACCOUNT_AGE_EXEMPT).",
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
