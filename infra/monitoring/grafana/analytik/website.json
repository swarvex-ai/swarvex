  {
   "type": "timeseries",
   "title": "Besucher und Seitenaufrufe je Tag",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "analytik"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "analytik"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "select t.tag::timestamptz as time, coalesce(b.besucher, 0) as \"Besucher\", coalesce(a.aufrufe, 0) as \"Seitenaufrufe\" from generate_series($__timeFrom()::date, $__timeTo()::date, interval '1 day') t(tag) left join (select tag, sum(besucher) as besucher from analytik.besucher group by 1) b on b.tag = t.tag::date left join (select tag, sum(aufrufe) as aufrufe from analytik.besuche group by 1) a on a.tag = t.tag::date order by 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 8
  },
