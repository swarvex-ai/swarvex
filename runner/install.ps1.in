# Install the swarvex runner on Windows, the one-liner (PowerShell):
#
#   irm @PLATFORM@/install.ps1 | iex
#
# The runner and its sandbox live in a separate WSL distribution called "swarvex" (Debian with rootless
# Podman), so project code never runs on Windows itself. This script sets the distribution up, installs the
# Linux runner inside it (install.sh verifies signature and checksum) and adds a "swarvex" command to Windows.
# It changes nothing else on your system; "swarvex uninstall" removes everything again.

& {
$ErrorActionPreference = 'Stop'
$Platform = '@PLATFORM@'
$Distro = 'swarvex'
$User = 'swarvex'
$Bin = Join-Path $env:LOCALAPPDATA 'swarvex\bin'
$env:WSL_UTF8 = '1'   # wsl.exe writes UTF-8 instead of UTF-16, so its output can be read

function Step($text) { Write-Host "`n== $text" }
function Ok($text) { Write-Host "   $text" }
class Stop : System.Exception { Stop([string]$m) : base($m) {} }
function Fail($text) { throw [Stop]::new($text) }
function Ask($question, [bool]$default = $true) {
  $hint = if ($default) { 'Y/n' } else { 'y/N' }
  $a = Read-Host "$question [$hint]"
  if ([string]::IsNullOrWhiteSpace($a)) { return $default }
  return $a.Trim().ToLower() -in @('y', 'yes', 'j', 'ja')
}
# Windows PowerShell 5.1 turns every line a program writes to stderr into an error, and with 'Stop' the script would end
# right there (for example when wsl.exe says that WSL is not installed yet). Programs therefore run with 'Continue';
# their exit code decides.
function Native([scriptblock]$command) {
  $before = $ErrorActionPreference
  $ErrorActionPreference = 'Continue'
  try { & $command } finally { $ErrorActionPreference = $before }
}
function Wsl { $a = $args; Native { & wsl.exe @a }; if ($LASTEXITCODE -ne 0) { Fail "wsl.exe $($a -join ' ') failed (exit code $LASTEXITCODE)" } }
# Long steps show a progress bar with the elapsed time and the usual duration, so nobody closes the window while
# Windows works in the background (installing WSL, downloading Debian, preparing Podman). Returns the exit code.
function Waiting($process, [string]$what, [int]$minutes) {
  $null = $process.Handle   # otherwise Windows PowerShell cannot read the exit code later
  $start = Get-Date
  while (-not $process.WaitForExit(1000)) {
    $s = [int]((Get-Date) - $start).TotalSeconds
    $status = '{0}:{1:00} elapsed, usually up to {2} minutes. Please keep this window open.' -f [math]::Floor($s / 60), ($s % 60), $minutes
    Write-Progress -Activity $what -Status $status -PercentComplete ([math]::Min(95, [int](100 * $s / ($minutes * 60))))
  }
  Write-Progress -Activity $what -Completed
  try { return $process.ExitCode } catch { return 0 }   # an elevated process may not tell us its exit code
}
function InDistro($script, [string]$what, [int]$minutes) {
  # runs a shell script as root inside the distribution; the script comes from a file on stdin, so Windows quoting cannot break it
  $file = New-TemporaryFile
  try {
    [IO.File]::WriteAllText($file.FullName, ($script -replace "`r", ''))
    $p = Start-Process wsl.exe -ArgumentList '-d', $Distro, '-u', 'root', '--', 'sh', '-s' -RedirectStandardInput $file.FullName -NoNewWindow -PassThru
    $code = Waiting $p $what $minutes
  } finally { Remove-Item $file.FullName -ErrorAction SilentlyContinue }
  if ($code -ne 0) { Fail "$what failed (exit code $code)." }
}

try {
  Step 'Checking requirements'
  $build = [Environment]::OSVersion.Version.Build
  if ($build -lt 19045) { Fail "Windows 10 22H2 or Windows 11 is required (this is build $build)." }
  if ($env:PROCESSOR_ARCHITECTURE -notin @('AMD64', 'ARM64')) { Fail "Processor $($env:PROCESSOR_ARCHITECTURE) is not supported." }
  $wslVersion = $null
  if (Get-Command wsl.exe -ErrorAction SilentlyContinue) {
    Ok 'checking WSL (its first start can take a minute) ...'
    # without WSL, wsl.exe only says so on stderr; that is not an error here but the answer "missing"
    $out = Native { (& wsl.exe --version 2>$null) -join "`n" }
    if ($LASTEXITCODE -eq 0 -and $out -match '(\d+)\.(\d+)\.(\d+)') { $wslVersion = [version]"$($Matches[1]).$($Matches[2]).$($Matches[3])" }
  }
  if (-not $wslVersion) {
    Write-Host "`nWSL (Windows Subsystem for Linux) is missing. The sandbox needs it, together with virtualization in the BIOS/UEFI."
    if (Ask 'Install WSL now? Windows asks for administrator rights once.') {
      Ok 'WSL is being installed in a separate administrator window. This usually takes 2 to 10 minutes; keep this window open.'
      # WSL from the Store does not always enable VirtualMachinePlatform; do both in one elevated window, so one restart is enough
      $elevated = 'wsl.exe --install --no-distribution; dism.exe /online /enable-feature /featurename:VirtualMachinePlatform /all /norestart'
      [void](Waiting (Start-Process powershell.exe -ArgumentList '-NoProfile', '-Command', $elevated -Verb RunAs -PassThru) 'Installing WSL' 10)
      Write-Host "`nWSL is installed. Restart Windows, then run the one-liner again:`n    irm $Platform/install.ps1 | iex"
    }
    return
  }
  if ($wslVersion -lt [version]'2.4.4') {
    Ok "WSL $wslVersion is too old, updating (Windows may ask for administrator rights; usually 1 to 5 minutes)"
    [void](Waiting (Start-Process wsl.exe -ArgumentList '--update' -Verb RunAs -PassThru) 'Updating WSL' 5)
  }
  Ok "Windows build $build, $($env:PROCESSOR_ARCHITECTURE), WSL $wslVersion"

  Step "WSL distribution '$Distro' (Debian)"
  function DistroThere { @(Native { & wsl.exe --list --quiet 2>$null } | ForEach-Object { "$_".Trim() }) -contains $Distro }
  if (-not (DistroThere)) {
    Ok 'downloading and installing Debian, usually 2 to 5 minutes ...'
    $code = Waiting (Start-Process wsl.exe -ArgumentList '--install', 'Debian', '--name', $Distro, '--no-launch' -NoNewWindow -PassThru) 'Installing Debian for swarvex' 5
    if ($code -ne 0) { Fail "Installing Debian failed (exit code $code)." }
    # If a Windows component such as VirtualMachinePlatform was still missing, WSL enables it, reports success
    # and installs no distribution until Windows has restarted.
    if (-not (DistroThere)) {
      Write-Host "`nWindows has enabled a component WSL needs (such as VirtualMachinePlatform); it only works after a restart."
      Write-Host "Restart Windows, then run the one-liner again:`n    irm $Platform/install.ps1 | iex"
      return
    }
    Ok 'installed'
  } else {
    Ok 'already there, updating it'
  }

  Step 'Preparing Podman inside'
  Ok 'installing Podman and its tools inside the distribution, usually 2 to 6 minutes the first time ...'
  InDistro -what 'Preparing Podman inside' -minutes 6 -script @"
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq >/dev/null
apt-get install -y -qq podman uidmap slirp4netns passt curl ca-certificates openssh-client tar git systemd systemd-sysv dbus-user-session >/dev/null
id $User >/dev/null 2>&1 || useradd -m -s /bin/bash $User
grep -q '^${User}:' /etc/subuid || usermod --add-subuids 100000-165535 --add-subgids 100000-165535 $User
printf '[boot]\nsystemd=true\n\n[user]\ndefault=$User\n' > /etc/wsl.conf
mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/$User
"@
  Wsl --terminate $Distro   # restart with systemd
  Ok 'Podman and systemd ready'

  Step 'Installing the runner inside the distribution'
  Native { & wsl.exe -d $Distro -u $User --cd '~' -- sh -c "curl -fsSL $Platform/install.sh | sh" }
  if ($LASTEXITCODE -ne 0) { Write-Host "`nThe setup inside did not finish. Continue any time with: swarvex setup" }

  Step "The 'swarvex' command for Windows"
  New-Item -ItemType Directory -Force -Path $Bin | Out-Null
  Set-Content -Encoding ascii -Path (Join-Path $Bin 'swarvex.cmd') -Value @"
@echo off
rem swarvex for Windows: forwards to the runner in the WSL distribution "$Distro" (install.ps1)
wsl.exe -d $Distro -u $User --cd ~ -- /home/$User/.local/bin/swarvex %*
set rc=%errorlevel%
if /i "%~1"=="service" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0swarvex-windows.ps1" service
if /i "%~1"=="setup" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0swarvex-windows.ps1" service
if /i "%~1"=="uninstall" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0swarvex-windows.ps1" uninstall
exit /b %rc%
"@
  Set-Content -Encoding ascii -Path (Join-Path $Bin 'swarvex-windows.ps1') -Value @"
# swarvex for Windows (install.ps1): keeps the WSL distribution running while the runner works as a service,
# and removes everything on uninstall.
param([string]`$was)
`$env:WSL_UTF8 = '1'
`$task = 'swarvex runner'
if (`$was -eq 'service') {
  & wsl.exe -d $Distro -u $User -- test -f /home/$User/.config/systemd/user/swarvex.service
  if (`$LASTEXITCODE -ne 0) { return }
  # WSL stops a distribution without running programs; a hidden program started at logon keeps it, and the service, alive
  `$aktion = New-ScheduledTaskAction -Execute 'conhost.exe' -Argument '--headless wsl.exe -d $Distro -u $User --exec sleep infinity'
  `$ausloeser = New-ScheduledTaskTrigger -AtLogOn -User `$env:USERNAME
  `$regeln = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)
  Register-ScheduledTask -TaskName `$task -Action `$aktion -Trigger `$ausloeser -Settings `$regeln -Force | Out-Null
  Start-ScheduledTask -TaskName `$task
  Write-Host "Windows keeps the runner running from logon on (scheduled task '`$task'). Pause: swarvex stop"
}
if (`$was -eq 'uninstall') {
  & wsl.exe -d $Distro -u $User -- test -x /home/$User/.local/bin/swarvex
  if (`$LASTEXITCODE -eq 0) { return }   # cancelled inside, nothing removed
  Unregister-ScheduledTask -TaskName `$task -Confirm:`$false -ErrorAction SilentlyContinue
  & wsl.exe --unregister $Distro | Out-Null
  `$pfad = [Environment]::GetEnvironmentVariable('Path', 'User') -split ';' | Where-Object { `$_ -and `$_ -ne '$Bin' }
  [Environment]::SetEnvironmentVariable('Path', (`$pfad -join ';'), 'User')
  Write-Host "Removed the WSL distribution '$Distro' and the swarvex command."
  Start-Process -WindowStyle Hidden cmd.exe -ArgumentList '/c', 'timeout /t 2 >nul & rmdir /s /q "$Bin"'
}
"@
  $pfad = [Environment]::GetEnvironmentVariable('Path', 'User')
  if (($pfad -split ';') -notcontains $Bin) {
    [Environment]::SetEnvironmentVariable('Path', (@($pfad, $Bin) | Where-Object { $_ }) -join ';', 'User')
    $env:Path = "$env:Path;$Bin"
    Ok "$Bin added to your PATH (new terminals see it)"
  }
  & (Join-Path $Bin 'swarvex-windows.ps1') service

  Step 'Agents on Windows for tasks without code'
  $mcp = "$Platform/mcp"
  $agenten = @(@(
    @{ Titel = 'Claude Code'; Programm = 'claude'; Befehl = @('mcp', 'add', '--scope', 'user', '--transport', 'http', 'swarvex', $mcp); Anmelden = 'in a session: /mcp -> swarvex -> Authenticate' },
    @{ Titel = 'Codex'; Programm = 'codex'; Befehl = @('mcp', 'add', 'swarvex', '--url', $mcp); Anmelden = 'sign-in starts right away; later: codex mcp login swarvex' },
    @{ Titel = 'Gemini CLI'; Programm = 'gemini'; Befehl = @('mcp', 'add', '--scope', 'user', '--transport', 'http', 'swarvex', $mcp); Anmelden = 'in a session: /mcp auth swarvex' },
    @{ Titel = 'Hermes'; Programm = 'hermes'; Befehl = @('mcp', 'add', 'swarvex', '--url', $mcp, '--auth', 'oauth'); Anmelden = 'sign-in starts right away; later: hermes mcp login swarvex' },
    @{ Titel = 'OpenClaw'; Programm = 'openclaw'; Befehl = @('mcp', 'add', 'swarvex', '--url', $mcp, '--transport', 'streamable-http', '--auth', 'oauth'); Anmelden = 'openclaw mcp login swarvex' },
    @{ Titel = 'opencode'; Programm = 'opencode'; Befehl = $null; Anmelden = 'opencode mcp auth swarvex' }
  ) | Where-Object { Get-Command $_.Programm -ErrorAction SilentlyContinue })
  if ($agenten.Count -eq 0) {
    Ok "No Claude Code, Codex, Gemini CLI, Hermes, OpenClaw or opencode found on Windows. Other agents: add the MCP server $mcp"
  } elseif (Ask "Also connect $(($agenten | ForEach-Object { $_.Titel }) -join ', ') directly (design, texts, reviews; no code runs on your machine)?") {
    foreach ($a in $agenten) {
      if ($null -eq $a.Befehl) {
        # opencode has no non-interactive `mcp add`: add the server to its config file (plain JSON only)
        $datei = Join-Path $HOME '.config\opencode\opencode.json'
        try {
          $k = if (Test-Path $datei) { Get-Content -Raw $datei | ConvertFrom-Json } else { [pscustomobject]@{} }
          if (-not $k.PSObject.Properties['mcp']) { $k | Add-Member -NotePropertyName mcp -NotePropertyValue ([pscustomobject]@{}) }
          $k.mcp | Add-Member -Force -NotePropertyName swarvex -NotePropertyValue ([pscustomobject]@{ type = 'remote'; url = $mcp })
          New-Item -ItemType Directory -Force -Path (Split-Path $datei) | Out-Null
          [IO.File]::WriteAllText($datei, ($k | ConvertTo-Json -Depth 20))   # UTF-8 without BOM; Set-Content would add one in PowerShell 5.1
          Ok "opencode connected. Sign in: $($a.Anmelden)"
        } catch { Ok "opencode: $datei is not plain JSON; add {""mcp"": {""swarvex"": {""type"": ""remote"", ""url"": ""$mcp""}}} yourself" }
        continue
      }
      # the agents ask their own questions (Hermes: "Enable all tools?") and start the sign-in: keep their output visible
      Write-Host "  $($a.Titel) asks a few things itself:"
      Native { & $a.Programm @($a.Befehl) }
      if ($LASTEXITCODE -eq 0) { Ok "$($a.Titel) connected. Sign in: $($a.Anmelden)" } else { Ok "$($a.Titel): could not add (already connected?)" }
    }
  }

  Write-Host "`nDone. In a new terminal: swarvex work (one task), swarvex status, swarvex stop, swarvex setup (change settings), swarvex uninstall."
} catch [Stop] {
  Write-Host "`nx $($_.Exception.Message)" -ForegroundColor Red
} catch {
  # anything unexpected: say where, so it can be reported, instead of a bare PowerShell error
  Write-Host "`nx Unexpected error: $($_.Exception.Message)" -ForegroundColor Red
  Write-Host "  at line $($_.InvocationInfo.ScriptLineNumber). Please report it: https://github.com/swarvex-ai/swarvex/issues"
}
}
