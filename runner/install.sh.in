#!/bin/sh
# Install the swarvex runner, the one-liner:
#
#   curl -fsSL @PLATFORM@/install.sh | sh
#
# Runs as a normal user (no root, no silent sudo). Verifies the signature of every
# download and stops if anything is wrong. Then: sign in in the browser.
# Lab only, with an internal CA: set SWARVEX_CA=/path/ca.crt before `sh`.
set -eu
PLATFORM="@PLATFORM@"
VERSION="@VERSION@"
SIGNING_KEY="@PUBKEY@"
CA_SOURCE="${SWARVEX_CA:-}"

fail() { printf '\n✗ %s\n' "$1" >&2; exit 1; }
step() { printf '\n== %s\n' "$1"; }

[ "$(id -u)" = "0" ] && fail "Please run as a normal user, not as root. The runner needs no root rights."
[ "$(uname -s)" = "Linux" ] || fail "Linux only for now (macOS and Windows will follow)."
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) fail "Processor $(uname -m) is not supported yet." ;;
esac

step "Checking requirements"
for tool in curl tar sha256sum ssh-keygen; do
  command -v "$tool" >/dev/null 2>&1 || fail "Missing: $tool"
done
if ! command -v podman >/dev/null 2>&1 || ! command -v newuidmap >/dev/null 2>&1; then
  hint="" install=""
  if command -v apt-get >/dev/null 2>&1; then
    pkgs="podman uidmap slirp4netns"
    # passt exists from Ubuntu 24.04 / Debian 12 on; older releases have no such package
    apt-cache show passt >/dev/null 2>&1 && pkgs="$pkgs passt"
    hint="sudo apt install $pkgs"
    install="sudo apt-get update && sudo apt-get install -y $pkgs"
  elif command -v dnf >/dev/null 2>&1; then hint="sudo dnf install podman"; install="sudo dnf install -y podman"
  elif command -v zypper >/dev/null 2>&1; then hint="sudo zypper install podman"; install="sudo zypper --non-interactive install podman"
  elif command -v pacman >/dev/null 2>&1; then hint="sudo pacman -S podman"; install="sudo pacman -S --needed --noconfirm podman"
  fi
  # Ask on the terminal (stdin is this script with curl | sh); sudo only after an explicit yes, never silently
  answer=""
  if [ -n "$install" ] && command -v sudo >/dev/null 2>&1 && ( : </dev/tty ) 2>/dev/null; then
    printf '\nThe runner needs rootless Podman (a sandbox for third-party project code). It is missing.\n'
    printf 'Install it now? This runs, with your password:\n    %s\n[Y/n] ' "$install"
    read -r answer </dev/tty || answer="n"
    case "$answer" in
      ""|[yYjJ]*) sh -c "$install" </dev/tty || fail "Installing Podman failed. Please install it yourself and run the one-liner again:
      $hint" ;;
    esac
  fi
  if ! command -v podman >/dev/null 2>&1 || ! command -v newuidmap >/dev/null 2>&1; then
    [ -n "$hint" ] || hint="install podman and uidmap (newuidmap) with your package manager"
    fail "The runner needs rootless Podman (a sandbox for third-party project code).
  Please install it once and run the one-liner again:
      $hint"
  fi
  echo "   Podman installed"
fi
[ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ] \
  || fail "Podman is not running rootless for this user (check podman info)."
# The sandbox reaches its key proxy by name on an internal network. Only Podman 4+
# with netavark offers DNS there; Podman 3 (Ubuntu 22.04, Linux Mint 21) does not.
PODMAN_VERSION="$(podman version --format '{{.Client.Version}}' 2>/dev/null || echo 0)"
[ "${PODMAN_VERSION%%.*}" -ge 4 ] 2>/dev/null \
  || fail "Podman $PODMAN_VERSION is too old; the runner needs Podman 4 or newer.
  Ubuntu 22.04 and Linux Mint 21 only ship Podman 3. Ubuntu 24.04, Linux Mint 22,
  Debian 12, Fedora and Arch are fine."
[ "$(podman info --format '{{.Host.NetworkBackend}}' 2>/dev/null)" = "netavark" ] \
  || fail "Podman uses the old CNI network backend; the runner needs netavark.
  Install netavark and aardvark-dns, then run 'podman system reset' (removes local
  containers and images) and the one-liner again."
# Images and project environments live in Podman's storage; building the agent image alone needs about 2 GB
STORE="$(podman info --format '{{.Store.GraphRoot}}' 2>/dev/null)"
mkdir -p "$STORE" 2>/dev/null || true
FREE_GB=$(( $(df -Pk "$STORE" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0) / 1048576 ))
LIVE=""
[ -d /run/casper ] || [ -d /run/live ] || grep -qs ' / overlay .*upperdir=/cow' /proc/mounts && LIVE="
  This looks like a live session without installation: it writes into RAM and has little space."
[ "$FREE_GB" -ge 2 ] || fail "Only ${FREE_GB} GB free for Podman ($STORE); the runner needs at least 2 GB, better 10 GB.$LIVE"
[ "$FREE_GB" -ge 10 ] || printf '   note: only %s GB free for Podman; project environments (such as Godot) can need several GB.%s\n' "$FREE_GB" "$LIVE"
echo "   ok: Linux/$ARCH, rootless Podman $PODMAN_VERSION, curl, tar, ssh-keygen"

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/swarvex"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/swarvex"
BIN="$HOME/.local/bin"
# Older installations were called schwarm-runner: take over sign-in and data instead of signing in again
for pair in "${XDG_CONFIG_HOME:-$HOME/.config}/schwarm-runner:$CONFIG" "${XDG_DATA_HOME:-$HOME/.local/share}/schwarm-runner:$DATA"; do
  old="${pair%%:*}"; new="${pair#*:}"
  if [ -d "$old" ] && [ ! -e "$new" ]; then mv "$old" "$new"; fi
done
rm -f "$BIN/schwarm-runner"
mkdir -p "$CONFIG" "$DATA" "$BIN"
CURL="curl -fsSL"
if [ -n "$CA_SOURCE" ]; then
  cp "$CA_SOURCE" "$CONFIG/ca.crt"
  CURL="curl -fsSL --cacert $CONFIG/ca.crt"
fi

step "Downloading runner $VERSION and verifying the signature"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
PACKAGE="swarvex-$VERSION-linux-$ARCH.tar.gz"
for file in "$PACKAGE" SHA256SUMS SHA256SUMS.sig; do
  $CURL -o "$TMP/$file" "$PLATFORM/downloads/$VERSION/$file" || fail "Download failed: $file"
done
printf 'swarvex-release %s\n' "$SIGNING_KEY" > "$TMP/allowed"
ssh-keygen -Y verify -f "$TMP/allowed" -I swarvex-release -n swarvex-release -s "$TMP/SHA256SUMS.sig" < "$TMP/SHA256SUMS" >/dev/null 2>&1 \
  || fail "The signature of the checksums is INVALID; nothing was installed."
( cd "$TMP" && grep " $PACKAGE\$" SHA256SUMS | sha256sum -c --status ) \
  || fail "The package checksum does NOT match; nothing was installed."
echo "   signature and checksum valid"

step "Installing"
rm -rf "$DATA/release" && mkdir -p "$DATA/release"
tar -xzf "$TMP/$PACKAGE" -C "$DATA/release"
install -m 755 "$DATA/release/swarvex" "$BIN/swarvex"
echo "   $BIN/swarvex"

step "Preparing the agent and the key proxy (takes a few minutes the first time)"
( cd "$DATA/release" && podman build -q -f Containerfile.proxy -t swarvex-proxy . >/dev/null ) || fail "Could not build the proxy image"
( cd "$DATA/release/sandbox" && podman build -q --target opencode -t swarvex-agent . >/dev/null ) || fail "Could not build the agent image"
podman rmi -f swarvex-agent-claude swarvex-agent-codex >/dev/null 2>&1 || true   # rebuilt on first use with this version
podman rmi -f swarvex-sandbox >/dev/null 2>&1 || true   # predecessor (sandbox with a fixed engine)
podman network exists swarvex-intern 2>/dev/null || podman network create --internal swarvex-intern >/dev/null
echo "   images and isolated network ready"

step "Signing in"
CA_ARG=""
[ -n "$CA_SOURCE" ] && CA_ARG="--ca $CONFIG/ca.crt"
if [ -f "$CONFIG/access.json" ] || [ -f "$CONFIG/zugang.json" ]; then
  echo "   already signed in (to sign in again: swarvex login --platform $PLATFORM)"
else
  # shellcheck disable=SC2086
  "$BIN/swarvex" login --platform "$PLATFORM" $CA_ARG
fi

case ":$PATH:" in *":$BIN:"*) ;; *) printf '\nNote: %s is not in your PATH; add it, e.g. in ~/.profile:\n  export PATH="$HOME/.local/bin:$PATH"\n' "$BIN" ;; esac
# Einrichtung gleich anschließen: wenige Fragen, Vorschläge aus dem, was schon da ist (swarvex setup).
# Über `curl … | sh` ist stdin das Skript, deshalb vom Terminal lesen; ohne Terminal (CI) nur der Hinweis.
if [ -z "${SWARVEX_NO_SETUP:-}" ] && ( : </dev/tty ) 2>/dev/null; then
  printf '\n✓ Installed. A few questions and your agent is ready (change later with: swarvex setup)\n'
  "$BIN/swarvex" setup </dev/tty || printf '\nSetup not finished. Continue any time with: swarvex setup\n'
else
  printf '\n✓ Installed. Next: swarvex setup\n'
fi
printf 'Visionary: check your project environment in its repository with  swarvex env\n'
